# Chave da API do Google Gemini (obrigatória para embeddings e geração de respostas)
# Aceita chaves AIzaSy... ou AQ... (configurável também pelo Painel Administrativo)
GEMINI_API_KEY=

# Senha do Painel Administrativo (padrão em desenvolvimento: admin123, igual ao infinito-games)
ADMIN_PASSWORD=admin123

# Conexão com o PostgreSQL + pgvector (Ex: Docker local, Supabase ou Neon)
# Se deixado em branco na PoC, o sistema usa automaticamente o banco local SQLite+NumPy (data/chatdbv_local.sqlite)
# Exemplo Docker local: postgresql://dbv:dbv_secret@localhost:5432/chatdbv
DATABASE_URL=

# Modelo de geração do Gemini (padrão: gemini-3.8-flash)
MODELO_CHAT=gemini-3.8-flash

# Quantidade de trechos (chunks) recuperados por pergunta no RAG
TOP_K=6

# Configurações de Identidade e Atendimento Público (gerenciáveis pelo Painel Admin)
NOME_CLUBE=Divisão Sul-Americana (DSA)
CHAT_ATIVO=true
MENSAGEM_MANUTENCAO=O Chat DBV está em manutenção pela Diretoria para atualização de manuais. Voltamos em breve!
