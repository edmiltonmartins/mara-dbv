# ==============================================================================
# Mara v2.0 — Configuração de Ambiente (.env.example)
# Copie este arquivo para `.env` e preencha suas credenciais locais.
# NUNCA versione o arquivo `.env` real em repositórios públicos.
# ==============================================================================

# Chave da API do Google Gemini (obrigatória para geração de respostas e simulados)
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Senha do Painel da Diretoria (/api/admin/* e aba Diretoria)
# IMPORTANTE: Altere obrigatoriamente para uma senha forte antes de expor na internet!
ADMIN_PASSWORD=troque_esta_senha_antes_de_publicar

# Conexão opcional com PostgreSQL 17 + pgvector
# Se deixado em branco, utiliza automaticamente SQLite + NumPy local (data/chatdbv_local.sqlite)
# Exemplo Docker: postgresql://dbv:dbv_secret@localhost:5432/chatdbv
DATABASE_URL=

# Modelo primário de geração do Gemini (com failover automático em picos de demanda)
MODELO_CHAT=gemini-3.8-flash

# Quantidade de trechos normativos recuperados por consulta no motor RAG híbrido
TOP_K=8

# Exibir referências técnicas de manual e página ao final das respostas
EXIBIR_DETALHES_TECNICOS=false

# Identidade exibida no cabeçalho do app e impressa nas provas/apostilas em PDF
NOME_CLUBE=Clube de Desbravadores — DSA
CHAT_ATIVO=true
MENSAGEM_MANUTENCAO=A Mara está em manutenção rápida pela Diretoria para atualização de manuais. Consulte a Biblioteca Offline!
